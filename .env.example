# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Settings → API). VITE_-prefixed vars are safe to
# ship in the deployed app; the anon key is meant to be public and is
# restricted by the Row Level Security policies in supabase/schema.sql.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed locally to run `npm run migrate:seed` once. Never put this in
# .env if that file might be committed or deployed — the service_role key
# bypasses all Row Level Security.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
